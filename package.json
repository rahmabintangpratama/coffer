{
  "name": "coffer",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-only, mobile-first file manager for S3-compatible object storage.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens:build": "node scripts/tokens/build.ts",
    "tokens:check": "node scripts/tokens/build.ts --check",
    "lint": "eslint .",
    "headers:check": "node scripts/headers/check.ts",
    "copy:check": "node scripts/copy/check.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "prepare": "node scripts/hooks/prepare.ts",
    "commitlint": "commitlint",
    "demo:presets": "COFFER_DEMO=1 vitest run src/lib/providers/providers.test.ts -t \"prints endpoint\" --silent=false",
    "demo:connection-test": "playwright test tests/e2e/connection-test.spec.ts --project=chromium-1440 --project=webkit-1440 --reporter=list",
    "size:check": "node scripts/size/check.ts",
    "dist:check": "node scripts/dist-check/check.ts",
    "lighthouse": "playwright test -c playwright.lighthouse.config.ts",
    "contrast:report": "node scripts/contrast/report.ts",
    "size:analyze": "COFFER_ANALYZE=1 vite build && node scripts/size/breakdown.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1173.0",
    "@aws-sdk/s3-request-presigner": "3.1173.0",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.108.1",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.18",
    "idb": "8.0.4",
    "intl-messageformat": "12.2.0",
    "lucide-react": "1.77.0",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "wouter": "3.13.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/jest-axe": "3.5.9",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jest-axe": "11.0.0",
    "jsdom": "31.0.1",
    "lefthook": "2.2.2",
    "lighthouse": "13.6.0",
    "puppeteer-core": "25.18.1",
    "rollup-plugin-visualizer": "7.1.3",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
